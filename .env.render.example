# Render Dashboard environment variables; never commit real credentials.
PORT=10000
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR_ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
# Render Blueprint generates this once. Keep it when redeploying or restoring the DB.
ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32
CONSOLE_USERNAME=admin
# Blueprint generates this; manual Web Service deployments must set their own.
CONSOLE_PASSWORD=choose-a-long-unique-password
EVOLT_VERSIONS_URL=https://YOUR_PUBLIC_EVOLT_HOST/api/ocpi/versions

# Optional: defaults to RENDER_EXTERNAL_URL on Render. Set only for a custom domain.
# PUBLIC_BASE_URL=https://YOUR_CONSOLE_DOMAIN

# Optional additional Evolt environments.
# CONSOLE_ENVS=stg
# EVOLT_VERSIONS_URL_STG=https://YOUR_STG_EVOLT_HOST/api/ocpi/versions

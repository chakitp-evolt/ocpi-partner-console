# Copy to .env for local runs. In k8s set these as env vars or have Vault Agent render them as dotenv
# into /vault/secrets/secret.env, /vault/secrets/config or /app/config/secret.env (see README → Vault).

PORT=8080

# Database: either DATABASE_URL, or the DATABASE_* parts below.
# DATABASE_URL=postgres://user:password@host:5432/partner_console?sslmode=require
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_USER=partner_console
DATABASE_PASSWORD=partner_console
DATABASE_NAME=partner_console
DATABASE_SSLMODE=disable

# Required. Seals every stored OCPI token (AES-256-GCM). Never rotate it in place:
# tokens sealed with the old key become unreadable.
ENCRYPTION_KEY=replace-with-a-long-random-key

# Public URL this console is reachable on; Evolt calls the partner mock back on it.
PUBLIC_BASE_URL=http://localhost:8080

# Optional locally; both are required on Render to protect the dashboard and API.
# CONSOLE_USERNAME=admin
# CONSOLE_PASSWORD=choose-a-long-unique-password

# Evolt OCPI Versions endpoint the mock registers against.
EVOLT_VERSIONS_URL=http://bff-external-service.dev.evtech.dev/api/ocpi/versions
